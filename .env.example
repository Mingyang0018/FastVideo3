# ═══ FastVideo3 密钥与运行配置模板 ═══
# 复制本文件为 .env：copy .env.example .env（Windows）/ cp .env.example .env

# ── ★ 必填：百炼 API Key（全系统唯一必需，获取: https://bailian.console.aliyun.com/）──
DASHSCOPE_API_KEY=

# ── 剧本模型 qwen3.7-plus 的专属端点（百炼模型市场）──
# 2026-08-30：工作空间专属端点实测 403（Workspace endpoint access denied）；
# 同一 KEY 在标准端点即可调用 qwen3.7-plus，故注释掉回落到标准端点。
# DASHSCOPE_TEXT_BASE_URL=https://ws-wlvar5cj0pbbtoho.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ── 思考模式：1=深度思考(流式, 慢) | 0=常规模式(结构化JSON稳, 默认) ──
FV3_ENABLE_THINKING=0

# ── ★ 模型选择（留空 = 跟随 configs/*.yaml 的 models: 段）────────────────
# ⚠ 这一组现在**主要由 Web 面板管理**：新建任务的「模型选择（高级）」里点名的模型，
#   除了落进那条 run 的 run_meta.json，还会**写回本文件的同名行**成为之后的默认
#   （只替换值、保留注释与密钥行；实现见 core/envfile.py）。多数用户不碰 .env，
#   不写回就会出现"面板选了 A、下一个任务跑的是 B"——因为环境变量优先级高于 yaml。
#   面板上能选哪些名字、以及校验规则，唯一来源是 core/model_catalog.py。
# 只改模型名即可，provider 类会按协议自动改道（见 fastvideo3/providers/protocols.py）：
# 例如 FV3_T2I_MODEL=qwen-image-3.0 会自动走 multimodal-generation 同步端点，
# 而不是万相异步 text2image 端点（后者会直接 400）。
# 覆盖只对百炼(dashscope)系生效；SiliconFlow/可灵的 fallback 模型仍只认 yaml。
FV3_TEXT_MODEL=qwen3.7-flash              # 编剧/评审文本（出厂默认已改为 flash；可选 plus/max/3.8 系见 model_catalog）
FV3_T2I_MODEL=qwen-image-3.0              # 文生图/首帧（默认 wanx2.1-t2i-turbo；high/cinema 用 wan2.7-image）
FV3_I2V_MODEL=wan3.0-video                # 图生视频（默认 wan2.2-i2v-flash / high 用 -plus）
# ⚠ 口型**不在面板的模型选择里**：通道由「口型模式」决定（core/talkmode.py，模式即通道）。
#   这里写了 FV3_TALK_MODEL 就是专家级手动覆盖，优先级最高，但模式与通道会重新拆成两份事实。
# C 链（口型模式 scripted_talk）的成片音轨来源：model=用模型原声（**默认**，嘴型与声音同轨）
# | master=换回我们的配音（音色统一，但实测语音领先口型 0～2.2 秒且偏移不恒定）。留空=跟随 yaml。
# FV3_VOICE_SOURCE=
FV3_TALK_MODEL=                            # 口型模型名/端点ID（默认 wan2.2-s2v；填 fal-ai/infinitalk 会自动改道到 fal provider）
FV3_R2V_MODEL=                            # 参考生视频（cinema 一致性引擎，默认 wan2.7-r2v；留空即不改）
FV3_VLM_MODEL=                            # 视觉评审（默认 qwen-vl-plus / cinema 用 -max）
FV3_TTS_MODEL=                            # 配音（默认 cosyvoice-v2；未开通/失败自动降级免费 edge-tts，
                                          #   并在 degradations.json 里留痕）
# ⚠ 配音两个硬规则（2026-10-05 实测）：① 音色名必须与模型版本配套 —— cosyvoice-**v2**
#   用无后缀的旧音色名（longwan 等）服务端回 418，此前每句都因此悄悄降级到 edge-tts；
#   m5 的音色池已按版本给名（COSY_V2_VOICES / COSY_V1_VOICES）。② 音色按角色**性别**分桶
#   分配（剧本 characters[].gender，缺失时从 appearance/name 关键词兜底），不再 md5 抽签。

# 备选（额度更大的档）：FV3_TEXT_MODEL=qwen3.7-plus / FV3_T2I_MODEL=qwen-image-3.0-pro
#                       FV3_I2V_MODEL=wan3.0-video-prime
# 口型换回百炼档示例：FV3_TALK_MODEL=videoretalk 或 wan2.2-s2v（protocols.py 会按名字自动改道）
# ⚠ qwen-mt-image-2.0 是图片翻译类模型，不能当文生图用（无 t2i 槽位）。

# ── 可选：fal.ai（MeiGen InfiniteTalk）API Key —— 口型**兜底**通道 ────────────
# 口型主通道 = 百炼 wan2.2-s2v（复用 DASHSCOPE_API_KEY，**不需要新 KEY**）。
# 只有希望 s2v 失败时还能退到 InfiniteTalk 才填这里（计费按输出秒：$0.20/秒@480p，720p 翻倍）。
FAL_KEY=
FAL_ACCELERATION=regular        # none | regular | high（fal 的加速档，影响质量/速度）

# ── 协议显式覆盖（仅当探测脚本发现某模型不走推断出的协议时才需要填）──────
# 取值：t2i → async_text2image | multimodal_sync
#       i2v/r2v → i2v_legacy | i2v_media_array
#       talk → s2v | videoretalk | i2v_media_array | fal_infinitalk_image | fal_infinitalk_v2v
# 先跑：python scripts/probe_models.py   它会把实测结论写进 configs/model_protocols.yaml
# FV3_T2I_PROTOCOL=multimodal_sync
# FV3_I2V_PROTOCOL=i2v_media_array

# ── 运行配置 ──
FV3_PROFILE=edu-sqlite          # edu-sqlite(零配置) | prod-postgres(docker compose，JobStore 台账走 PG)
# ── 口型模式：留空 = 跟随各画质档的**配对值**（2026-10-11 四次定档）──────────────
#   economy / high → s2v_direct   （主通道 wan2.2-s2v 只吃「图片+音频」）
#   cinema         → v2v_overlay  （主通道 videoretalk 吃「运动片段+音频」，1080P 不降级）
# ⚠ 这一项**优先级高于 configs/*.yaml**：写死它就会把上面的档位差异静默盖掉，后果是
#   "对白镜头先烧一份 i2v 的钱、再 100% 降级成无口型叠音，且生成镜头视频步骤永远不绿"。
#   确需全局覆盖时才取消注释（run_meta.json 里的值仍优先于本项）。
# FV3_TALK_MODE=                # s2v_direct | v2v_overlay | audio_overlay(显式不做口型)
# 口型端点：默认公共端点（华北2/北京）。若业务空间隔离导致报错，改成：
# FV3_S2V_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1
FV3_BUDGET_LIMIT_CNY=120        # 成本上限(元); 含口型后 30s 成片≈¥52-82(1080P)、¥28-40(720P)、¥14-20(480P)

# ── 真实成本（台账金额 = 单价 × 用量）────────────────────────────────
# 用量：优先取 API 回传的 usage（官方"只对成功的结果计数"，含 output_video_duration 与 SR），
#       取不到才退回"我们请求的时长"，并在 cost.json 的 meta.quantity_source 里标明是哪种。
# 单价：三级来源，**远端价目表 > pricing.yaml > 能力默认价(估算)**；最后一级会标
#       price_certain=false，看板与 doctor 会把"其中 ¥X 是估算"单独说出来。
# FV3_PRICING_URL=              # 指向与 pricing.yaml 同构的 JSON（{"models":{...},"defaults":{...}}）
# FV3_PRICING_TTL_HOURS=24      # 远端价目表本地缓存有效期；过期才重新拉，拉不到就用旧缓存并说明
# 真实账单对账（可选）：阿里云 BSS 需要 **RAM 的 AK/SK**，与百炼 DASHSCOPE_API_KEY 不是同一个凭据。
# 配好后跑 `python scripts/real_cost.py output/<run_id>` 或 `--all` 对比账单与台账差额。
# 不配也能跑，只是台账始终是估算（免费额度转正式计费/官方调价/漏登记都反映不出来）。
# FV3_ALIYUN_ACCESS_KEY_ID=
# FV3_ALIYUN_ACCESS_KEY_SECRET=
FV3_FAKE=0                      # 1=Fake 模式(零成本离线演示, 无需 KEY)

# ── 可选备选供应商（留空即全走百炼）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ── 进阶数据库（FV3_PROFILE=prod-postgres 时生效，与 docker-compose.yml 一致）──
FV3_PG_HOST=localhost
FV3_PG_PORT=5432
FV3_PG_DB=fastvideo3
FV3_PG_USER=fv3
FV3_PG_PASSWORD=fv3_change_me

# ── 运行环境（可选，全部有默认值）──
# 这些不是模型配置，是"这份代码夹在哪里、用什么二进制跑"。`fastvideo3 doctor` 会逐项显示来源。
# ffmpeg 解析顺序：FV3_FFMPEG_PATH → 项目内 bin/ → venv 的 imageio-ffmpeg → 系统 PATH。
# 留空即可：`fastvideo3 provision` 会把 ffmpeg 复制进 bin/，之后这份目录拷走就能独立上线。
# FV3_FFMPEG_PATH=
# FV3_OUTPUT_DIR=output            # 产物根目录（相对路径按项目根解析；sqlite 台账也在这里）
# FV3_PRICING_URL=                 # 实时价目表（远端优先于本地 pricing.yaml）
# FV3_PRICING_TTL_HOURS=24
